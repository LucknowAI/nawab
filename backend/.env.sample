# --- AI providers ---
# Gemini if GEMINI_API_KEY is set; otherwise OPENAI_MODEL_NAME (pydantic-ai).
# OPENAI_API_KEY / OPENAI_BASE_URL are read from the environment for OpenAI-compatible hosts.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=google:gemini-3-flash-preview
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=openai:gpt-5.2
SERPER_API_KEY=
API_TIMEOUT=10

# --- STT (Groq Whisper) ---
GROQ_API_KEY=
GROQ_TRANSCRIPTION_URL=https://api.groq.com/openai/v1/audio/transcriptions

# --- TTS (Kokoro-82M; lazy-loaded; install requirements-tts.txt + espeak-ng) ---
TTS_PROVIDER=kokoro
TTS_MODEL_ID=hexgrad/Kokoro-82M
TTS_DEVICE=auto
TTS_MAX_CHARS=500
TTS_VOICE=hm_psi
TTS_LANG_CODE=h
TTS_SPEED=1.05
# Optional Hugging Face token if the model repo requires auth
HF_TOKEN=

# --- Auth ---
JWT_SECRET=
JWT_ALGORITHM=HS256
GOOGLE_CLIENT_ID=
# Short-lived single-use ticket for browser → backend WebSocket auth
WS_TICKET_TTL_SECONDS=60
# OTP verify attempt limit (request-side OTP send limit is separate)
OTP_VERIFY_MAX_ATTEMPTS=5
OTP_VERIFY_WINDOW_SECONDS=600

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Observability ---
# Write token from https://logfire.pydantic.dev (project settings -> write tokens).
# Unset -> spans just print to console, no code change needed either way.
LOGFIRE_TOKEN=

# --- Rate limiting / workers ---
RATE_LIMIT=100
MAX_WORKERS=10
BAN_THRESHOLD=5
BAN_DURATION=3600
# WebSocket per-user run limits (Redis-backed when available; else process-local)
WS_RUN_RATE_LIMIT=30
WS_RUN_RATE_WINDOW_SECONDS=60
WS_MAX_CONCURRENT_RUNS=1
WS_CONNECT_RATE_LIMIT=30
WS_CONNECT_RATE_WINDOW_SECONDS=60

# --- STT upload limits ---
MAX_STT_FILE_BYTES=8388608

# --- List / feedback clamps ---
MAX_LIST_LIMIT=100
MAX_FEEDBACK_MESSAGE_CHARS=1000

# --- Cache ---
CACHE_PREFIX=nawab:

# --- Database ---
POSTGRES_DB_URL=postgresql+asyncpg://user:password@localhost:5432/nawab
REDIS_URL=redis://localhost:6379/0
SESSION_TIMEOUT=3600
MAX_CONTEXT_MESSAGES=20

# --- Email / SMTP (OTP delivery) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nawab AI <noreply@example.com>

# --- City / multi-persona ---
DEFAULT_CITY_ID=lucknow

# --- CORS — comma-separated list of allowed frontend origins ---
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:9001

# --- Cookies ---
# COOKIE_SECURE defaults to `ENVIRONMENT != development`; override explicitly if needed.
COOKIE_SECURE=
COOKIE_SAMESITE=none
